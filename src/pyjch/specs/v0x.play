// JCH NewPlayer V0x. The tempo counts calls; each time it runs out every voice's beat counter
// counts down. A voice whose counter has run out reads on: its order list names subpatterns
// ($80..$9F sets the transpose, from $A0 it restarts), a subpattern is note, rest ($00), tie
// ($7F) and duration ($80..$8F) bytes up to $90.., where it returns to the order list.
spec v0x;

layout {
  load, subptr_lo, subptr_hi: addr;
  gate_ctrl, gateoff_ctrl: byte;
  init_tempo, init_speed: byte;
  init_left, init_beats, init_transpose, init_inside, init_shift, init_detune, init_freq,
  init_base, init_cur: list;
}

event order_byte: row;
event sub_byte: row;
event sub_start: row;

cell ftab: u8[192] @ L.load + 0x21F ro;
cell subpatterns: u16[128] @ (L.subptr_lo, L.subptr_hi) ro;

state tempo: u8 = L.init_tempo;
state speed: u8 = L.init_speed;

counter beat: tempo { on frame -= 1; reload speed; wrap when tempo == 1 -> row; }
handler count_down on row {
  for k in 0..3 {
    voice[k].left -= 1;
  }
}

machine clock {
  step {
    fire frame;
  }
}

machine voice[x in 0..3] {
  record chip @ 0xD400 stride 7 { out_freq: u16; out_ctrl: u8 @ 4; }

  state left: u8 = L.init_left[x];
  state beats: u8 = L.init_beats[x];
  state freq: u16 = L.init_freq[x];
  state transpose: u8 = L.init_transpose[x];
  state inside: u8 = L.init_inside[x];
  state shift: u8 = L.init_shift[x];
  state detune: u8 = L.init_detune[x];
  state base: u16 = L.init_base[x];
  state orderpos: u8 = L.init_cur[x] - L.init_base[x];
  state subpos: u8 = 0;
  state entry: u8 = 0;
  state byte: u8 = 0;

  signal retrigger: bool = false;

  cursor orderlist {
    stream @ base grammar "pyjch.grammar:GRAMMAR:v0x_orderlist";
    pos orderpos;
    on order_byte next;
    field item -> entry = item;
  }

  cursor subpattern {
    stream @ subpatterns[entry] grammar "pyjch.grammar:GRAMMAR:v0x_subpattern";
    pos subpos;
    on sub_byte next;
    on sub_start reset;
    field item -> byte = item;
  }

  // Reads on until a note, rest or tie has been read.
  proc read_on() {
    left := beats;
    let reading = true;
    while reading bound 4096 {
      if inside == 0 {
        react orderlist on order_byte();
        match entry {
          0x00..0x7F => {
            inside := 1;
            fire sub_start;
          }
          0x80..0x9F => transpose := ((entry & 0x1F) - 0x0C) << 1;
          _ => {
            orderpos := 0;
            left := beats;
          }
        }
      } else {
        react subpattern on sub_byte();
        match byte {
          0x80..0x8F => {
            left := byte & 0x0F;
            beats := byte & 0x0F;
          }
          0x90..0xFF => inside := 0;
          0x00 => {
            out_ctrl := L.gateoff_ctrl;
            reading := false;
          }
          0x7F => reading := false;
          _ => {
            let at = u16((byte << 1) + shift + transpose);
            freq := word(ftab[at], ftab[at + 1]) + u16(detune);
            retrigger := true;
            reading := false;
          }
        }
      }
    }
  }

  step {
    if neg(left) {
      read_on();
    }
    if retrigger {
      out_ctrl := L.gate_ctrl;
    }
    out_freq := freq;
  }
}

schedule {
  voice[2];
  voice[1];
  voice[0];
  clock;
}
