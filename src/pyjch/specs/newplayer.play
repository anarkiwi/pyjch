// JCH NewPlayer V20. The groove counts ticks down; a voice sounds its instrument every tick,
// reads its next row on tick 2 of the row's last beat and starts it on tick 0. An order list
// names patterns ($80.. transposes the next, $FF loops, $FE stops the voice); a pattern is
// duration, instrument and command bytes up to a note, rest ($00) or hold ($7E), and ends at $7F.
// An instrument's pulse, filter and wave programs are tables of steps linked by a next offset.
spec newplayer;

layout {
  pitch, wave_note, wave_ctrl, filter, pulse, instruments, patlo, pathi, cmdparam,
  rearm_ad, rearm_sr: addr;
  wild: list;
  hardrestart: byte;
  init_vol, init_resfilt, init_scratch, init_vibdelta, init_tempo, init_groove_ctr, init_groove_pos, init_fpos, init_fdwell,
  init_cutoff, init_fmode, init_delay: byte;
  init_active, init_freq, init_note, init_trans, init_gate, init_inst, init_start, init_rst,
  init_patpos, init_length, init_remaining, init_ctrl, init_detune, init_porta_on, init_vib_on,
  init_vibrate, init_vibwait, init_vibperiod, init_vibdir, init_vibacc, init_vibdep, init_vibbacc,
  init_pwcur, init_pwdw, init_pw, init_pwdir, init_wtptr, init_wtdw, init_wtdwrel, init_rearming, init_tie,
  init_portaslide, init_portadir, init_portaacc, init_s_trans, init_s_inst, init_s_note,
  init_s_porta, init_s_vib, init_s_gate, init_s_sr, init_ad, init_sr, init_ported, init_vibed, init_quiet: list;
}

event fetch: tick;
event order_byte: fetch;
event pattern_byte: fetch;
event pattern_end: fetch;
event beat: tick;
event swing: beat;
event pulse_tick: tick;
event pulse_row: pulse_tick;
event filter_tick: tick;
event filter_row: filter_tick;
event wave_tick: tick;
event wave_row: wave_tick;
event porta_tick: tick;
event vib_tick: tick;
event vib_turn: vib_tick;

cell cutoff_reg: u8 @ 0xD416 out;
cell resfilt_reg: u8 @ 0xD417 out;
cell modevol_reg: u8 @ 0xD418 out;

// Song data: instruments, pattern pointers, command table, and the programs' tables.
table instrument @ L.instruments stride 8 {
  ad: u8; sr: u8; wave: u8; filter: u8; filter_start: u8; pulse_start: u8;
  wave_start: u8; wave_release: u8;
}
cell patterns: u16[256] @ (L.patlo, L.pathi) ro;
table command @ L.cmdparam stride 2 { kind: u8; arg: u8; }
cell pitch: u16[129] @ L.pitch ro;
// The 96 notes are followed by the player's variables; L.wild names, for each byte a note past
// them can read, the variable there (kind * 4 + voice; 0: the byte is not a variable).
cell wave_note: u8[256] @ L.wave_note ro;
cell wave_ctrl: u8[256] @ L.wave_ctrl ro;
view pulse_step @ pwrow { value @ 0; step @ 1; rate @ 2; next @ 3; }
view filter_step @ fptr { cut @ 0; step @ 1; dwell @ 2; next @ 3; }
cell groove: u8[2] @ L.filter ro;
cell filter_voice: u8 @ L.filter + 3 ro;
cell rearm_ad: u8 @ L.rearm_ad ro;
cell rearm_sr: u8 @ L.rearm_sr ro;

state vol: u8 = L.init_vol;
state resfilt: u8 = L.init_resfilt;
state scratch: u8 = L.init_scratch;
state vibdelta: u8 = L.init_vibdelta;
state delay: u8 = L.init_delay;
state tempo: u8 = L.init_tempo;
state groove_ctr: u8 = L.init_groove_ctr;
state groove_pos: u8 = L.init_groove_pos;
state fptr: u16 = u16(L.filter) + u16(L.init_fpos);
state fdwell: u8 = L.init_fdwell;
state cutoff: u8 = L.init_cutoff;
state fmode: u8 = L.init_fmode;

// The groove counts down once per call and reloads with the tempo; a tempo below 2 reads the
// reload from the two-entry groove instead, alternating.
counter ticks: groove_ctr {
  on frame -= 1;
  reload ite(tempo < 2, groove[groove_pos], tempo);
  wrap when neg(groove_ctr - 1) -> beat;
}
counter swung: groove_pos { on swing -= 1; reload 1; }
handler on_beat on beat {
  if tempo < 2 {
    fire swing;
  }
}

// The filter program: a step sets the cutoff unless $FF and dwells; the cutoff ramps by the
// step's amount each tick.
counter filter_dwell: fdwell {
  on filter_tick -= 1;
  wrap when neg(fdwell - 1) -> filter_row;
}
handler filter_next on filter_row {
  fptr := L.filter + u16(filter_step.next);
  load_filter();
}
accum filter_sweep: cutoff { step filter_step.step; on filter_tick ramp; }

proc load_filter() {
  if filter_step.cut != 0xFF {
    cutoff := filter_step.cut;
  }
  fdwell := filter_step.dwell;
}

machine clock {
  step {
    fire frame;
  }
}

machine voice[x in 0..3] {
  record chip @ 0xD400 stride 7 {
    out_freq: u16; out_pw: u12; out_ctrl: u8; out_ad: u8; out_sr: u8;
  }

  state active: u8 = L.init_active[x];
  state freq: u16 = L.init_freq[x];
  state note: u8 = L.init_note[x];
  state trans: u8 = L.init_trans[x] >> 1;
  state gate: u8 = L.init_gate[x];
  state inst: u8 = L.init_inst[x] >> 3;
  state detune: u8 = L.init_detune[x];
  state ctrl: u8 = L.init_ctrl[x];
  state porta_on: u8 = L.init_porta_on[x];
  state vib_on: u8 = L.init_vib_on[x];
  state rearming: u8 = L.init_rearming[x];

  state start: u16 = L.init_start[x];
  state loop: u8 = L.init_rst[x] - L.init_start[x];
  state orderpos: u8 = 0;
  state patpos: u8 = L.init_patpos[x];
  state length: u8 = L.init_length[x];
  state remaining: u8 = L.init_remaining[x];
  state tie: u8 = L.init_tie[x];
  state item: u8 = 0;

  state s_trans: u8 = L.init_s_trans[x] >> 1;
  state s_inst: u8 = L.init_s_inst[x] >> 3;
  state s_note: u8 = L.init_s_note[x];
  state s_porta: u8 = L.init_s_porta[x];
  state s_vib: u8 = L.init_s_vib[x];
  state s_gate: u8 = L.init_s_gate[x];
  state s_sr: u8 = L.init_s_sr[x];
  state ad: u8 = L.init_ad[x];
  state sr: u8 = L.init_sr[x];
  state ported: u8 = L.init_ported[x];
  state vibed: u8 = L.init_vibed[x];
  state quiet: u8 = L.init_quiet[x];

  state pwrow: u16 = u16(L.pulse) + u16(L.init_pwcur[x]);
  state pwdw: u8 = L.init_pwdw[x];
  state pwdir: u8 = L.init_pwdir[x] >> 7;
  state pw: u16 = L.init_pw[x];

  state wtptr: u8 = L.init_wtptr[x];
  state wtdw: u8 = L.init_wtdw[x];
  state wtdwrel: u8 = L.init_wtdwrel[x];

  state portaslide: u16 = L.init_portaslide[x];
  state portadir: u8 = L.init_portadir[x] >> 5;
  state portaacc: u16 = L.init_portaacc[x];

  state vibrate: u8 = L.init_vibrate[x];
  state vibwait: u8 = L.init_vibwait[x];
  state vibperiod: u8 = L.init_vibperiod[x];
  state vibdir: u8 = L.init_vibdir[x];
  state vibacc: u16 = L.init_vibacc[x];
  state vibdep: u8 = L.init_vibdep[x];
  state vibbacc: u8 = L.init_vibbacc[x];

  signal started: bool = false;
  signal vibstep: u16 = 0;

  cursor orderlist {
    stream @ start grammar "pyjch.grammar:GRAMMAR:orderlist";
    pos orderpos;
    on order_byte next;
    field entry -> s_trans = entry & 0x7F when neg(entry);
  }

  cursor pattern {
    stream @ patterns[orderlist.ahead] grammar "pyjch.grammar:GRAMMAR:pattern";
    pos patpos;
    on pattern_byte next;
    on pattern_end reset;
    field byte -> item = byte;
  }

  // The beat counts rows: when a note's rows run out the next one starts.
  counter row_left: remaining {
    on row -= 1;
    reload length;
    wrap when neg(remaining - 1) -> note;
  }

  // Pulse width: a step may set the width, then adds or subtracts its amount each tick for
  // its dwell.
  counter pulse_dwell: pwdw {
    on pulse_tick -= 1;
    wrap when neg(pwdw - 1) -> pulse_row;
  }
  handler pulse_next on pulse_row {
    pwrow := L.pulse + u16(pulse_step.next);
    load_pulse();
  }
  accum pulse_width: pw { step pulse_step.step; dir pwdir; on pulse_tick triangle; }

  // The wave program: control byte per row, a row lasts the instrument's dwell.
  latch ctrl := wave_ctrl[wtptr] on wave_tick;
  counter wave_dwell: wtdw {
    on wave_tick -= 1;
    reload wtdwrel;
    wrap when neg(wtdw - 1) -> wave_row;
  }
  handler wave_next on wave_row {
    wtptr += 1;
  }

  accum portamento: portaacc { step portaslide; dir portadir; on porta_tick triangle; }

  // Vibrato: a triangle whose depth ramps up, half a period at a time.
  counter vib_half: vibwait {
    on vib_tick -= 1;
    reload vibperiod;
    wrap when neg(vibwait - 1) -> vib_turn;
  }
  accum vibrato: vibacc { step vibstep; dir vibdir; on vib_tick triangle; on vib_turn flip; }
  accum vib_ramp: vibbacc { step vibrate; on vib_tick ramp; }

  proc load_pulse() {
    pwdir := pulse_step.rate >> 7;
    pwdw := pulse_step.rate & 0x7F;
    let v = pulse_step.value;
    if v != 0xFF {
      pw := word(v & 0xF0, v & 0x0F);
    }
  }

  proc wild_byte(at: u8, memory: u8) -> u8 {
    for p in 0..66 {
      if at == p {
        for k in 0..3 {
          if L.wild[p] & 3 == k {
            match L.wild[p] >> 2 {
              1 => return vibdelta;
              2 => return lo(voice[k].start + u16(voice[k].orderpos));
              3 => return hi(voice[k].start + u16(voice[k].orderpos));
              4 => return groove_ctr;
              5 => return tempo;
              6 => return voice[k].tie;
              7 => return voice[k].vib_on;
              8 => return voice[k].porta_on;
              9 => return voice[k].patpos;
              10 => return voice[k].rearming;
              11 => return voice[k].length;
              12 => return voice[k].remaining;
              13 => return voice[k].ctrl;
              14 => return voice[k].ported;
              15 => return voice[k].vibed;
              16 => return voice[k].quiet;
              17 => return voice[k].vibwait;
              18 => return voice[k].vibperiod;
              _ => return memory;
            }
          }
        }
      }
    }
    return memory;
  }

  proc pitch_word(index: u8) -> u16 {
    let word_at = pitch[u16(index)];
    if index < 96 {
      return word_at;
    }
    let at = 2 * (index - 96);
    let low = wild_byte(at, lo(word_at));
    let high = wild_byte(at + 1, hi(word_at));
    return word(low, high);
  }

  proc resolve_wave() {
    match wave_note[wtptr] {
      0x7E => wtptr -= 1;
      0x7F => wtptr := wave_ctrl[wtptr];
    }
  }

  proc output() {
    out_freq := freq;
    out_pw := pw;
    out_ad := ad;
    out_sr := sr;
    out_ctrl := ctrl & gate;
    ported := 0;
    vibed := 0;
    quiet := 0;
    cutoff_reg := cutoff;
    modevol_reg := fmode | vol;
  }

  // The sound of one tick: the wave program picks the pitch, then slide or vibrato.
  proc tone() {
    resolve_wave();
    let a = wave_note[wtptr];
    if (instrument[inst].wave & 0x40) != 0 {
      freq := u16(a) << 8;
    } else {
      scratch := ite(neg(a), 1, 0);
      let tuned = pitch_word(ite(neg(a), a, a + note + trans) & 0x7F);
      freq := tuned + u16(detune);
    }
    fire wave_tick;
    if porta_on != 0 {
      fire porta_tick;
      if scratch == 0 {
        freq += portaacc;
      }
    } elif vib_on != 0 && quiet == 0 {
      let here = pitch_word(note & 0x7F);
      let above = pitch_word((note & 0x7F) + 1);
      let span = above - here;
      vibstep := (span & 0xFF | u16(hi(span) + vibbacc) << 8) >> ite(neg(vibdep - 1), 0, vibdep);
      scratch := hi(vibstep);
      vibdelta := lo(vibstep);
      fire vib_tick;
      freq += vibacc;
    }
    output();
  }

  proc start_instrument() {
    let ins = inst;
    wtptr := instrument[ins].wave_start;
    stream program = L.wave_note + u16(wtptr) @ 0 grammar "pyjch.grammar:GRAMMAR:wave_program";
    rearming := instrument[ins].wave & 0x80;
    wtdw := instrument[ins].wave & 0x0F;
    wtdwrel := instrument[ins].wave & 0x0F;
    pwrow := L.pulse + u16(instrument[ins].pulse_start);
    load_pulse();
    scratch := instrument[ins].filter & 0xF0;
    let route = instrument[ins].filter & 0x0F;
    if route == 0 || route == 8 {
      resfilt := resfilt & ~u8(1 << x);
    } else {
      fmode := route << 4;
      modevol_reg := fmode | vol;
      resfilt := (resfilt & 0x0F) | (1 << x) | (instrument[ins].filter & 0xF0);
    }
    resfilt_reg := resfilt;
    if route != 0 {
      fptr := L.filter + u16(instrument[ins].filter_start);
      load_filter();
    }
    ad := instrument[ins].ad;
    sr := s_sr;
    out_ad := ad;
    out_sr := sr;
    out_ctrl := L.hardrestart;
  }

  proc sound() {
    fire pulse_tick;
    if x == filter_voice {
      fire filter_tick;
    }
    tone();
  }

  proc command_row(index: u8) {
    let kind = command[index].kind;
    let arg = command[index].arg;
    scratch := kind & 0x0F;
    match kind & 0xF0 {
      0x00..0x20 => {
        portadir := (kind >> 5) & 1;
        portaslide := word(arg, kind & 0x0F);
        s_porta := 1;
        ported := 1;
      }
      0x60 => {
        s_vib := 1;
        vibed := 1;
        vibrate := kind & 0x0F;
        vibperiod := arg >> 4;
        vibwait := (arg >> 4) - 1;
        vibdir := 0;
        vibbacc := 0;
        vibacc := 0;
        vibdep := arg & 0x0F;
      }
      0xE0 => tempo := arg;
      0xF0 => vol := arg;
      0x90 => s_sr := arg;
      _ => {
        instrument[kind & 0x1F].wave_start := arg;
        instrument[kind & 0x1F].wave_release := arg;
      }
    }
  }

  proc read_note(b: u8) {
    match b {
      0 => {
        tie += 1;
        if gate != 0xFE {
          s_gate := 0xFE;
          if instrument[inst].wave_release != instrument[inst].wave_start {
            wtptr := instrument[inst].wave_release;
            stream program = L.wave_note + u16(wtptr) @ 0 grammar "pyjch.grammar:GRAMMAR:wave_program";
          }
        }
      }
      0x7E => {
        tie += 1;
        s_gate := 0xFF;
      }
      _ => {
        s_note := b;
        if ported == 0 {
          s_porta := 0;
        }
        if vibed == 0 {
          s_vib := 0;
        }
        s_gate := 0xFF;
      }
    }
  }

  // The row read two ticks ahead: instrument, duration and commands up to a note; the order
  // list moves on when the pattern's next byte is its end.
  handler read_row on fetch {
    tie := 0;
    if neg(orderlist.ahead) {
      react orderlist on order_byte();
    }
    let noted = false;
    while !noted bound 256 {
      react pattern on pattern_byte();
      let b = item;
      match b {
        0x80..0x9F => {
          tie := b & 0x10;
          length := b & 0x0F;
        }
        0xA0..0xBF => {
          s_inst := b & 0x1F;
          s_sr := instrument[b & 0x1F].sr;
        }
        0xC0..0xFF => command_row(b & 0x3F);
        _ => {
          noted := true;
          read_note(b);
        }
      }
    }
    if pattern.ahead == 0x7F {
      fire pattern_end;
    }
    started := true;
    if active != 0 {
      if tie == 0 {
        gate := 0xFE;
      }
      if tie == 0 && rearming != 0 {
        ad := rearm_ad;
        sr := rearm_sr;
        output();
      } elif delay != 0 {
        quiet := 1;
        tone();
      } else {
        sound();
      }
    }
  }

  handler next_pattern on pattern_end {
    react orderlist on order_byte();
    if orderlist.ahead == 0xFF {
      orderpos := loop;
    } elif orderlist.ahead == 0xFE {
      active := 0;
      out_ctrl := 0;
    }
  }

  // A new note takes the staged row; a tied one only goes on sounding.
  handler note_start on note {
    started := true;
    gate := s_gate;
    note := s_note;
    trans := s_trans;
    vib_on := s_vib;
    inst := s_inst;
    porta_on := s_porta;
    if s_porta == 0 {
      portaacc := 0;
    }
    if tie != 0 {
      sound();
    } else {
      start_instrument();
    }
  }

  step {
    if active != 0 {
      if groove_ctr == 0 {
        fire row;
      } elif groove_ctr == 2 && remaining == 0 {
        fire fetch;
      }
      if !started {
        sound();
      }
    }
  }
}

schedule {
  clock;
  voice[2];
  voice[1];
  voice[0];
}
